# Copy to .env for local reference (do not commit .env)

AWS_PROFILE=terraform-user
AWS_REGION=us-east-1

# App identity — matches ECR repo, ECS cluster/service, and Docker labels
PROJECT_NAME=fastapi-translation
CONTAINER_PORT=3000
HEALTH_CHECK_PATH=/health

# Local Docker
LOCAL_IMAGE=fastapi-translation:local
LOCAL_CONTAINER=fastapi-translation-app
BASE_URL=http://localhost:3000

# After deploy: use terraform output api_url
# BASE_URL=http://fastapi-translation-alb-xxxxxxxx.us-east-1.elb.amazonaws.com
